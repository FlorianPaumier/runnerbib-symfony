# Copy to .env.docker; Make passes it to Compose explicitly.
HTTP_PORT=8080
MAILPIT_PORT=8025
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
# Production only: separately provision a restricted role; no owner fallback.
RUNTIME_DATABASE_URL=
APP_SECRET=local-development-only
XDEBUG_MODE=off
# Production: replace both secrets and provide a real mail transport.
MAILER_DSN=null://null

# Local disposable cache/session credentials; replace in production.
REDIS_PASSWORD=local-redis-only
REDIS_URL=redis://:local-redis-only@redis:6379
# Production must use a trusted HTTPS origin and verified sender.
APP_BASE_URL=http://localhost:8080
MAILER_FROM=no-reply@example.test

# Configure all Stripe operator settings explicitly before enabling sellers.
STRIPE_PROVIDER_SCOPE=unconfigured
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=0
STRIPE_DASHBOARD=
STRIPE_FEES_COLLECTOR=
STRIPE_LOSSES_COLLECTOR=
STRIPE_SELLER_RETURN_URL=
STRIPE_SELLER_REFRESH_URL=
OPTIONAL_NOTIFICATION_EMAIL_POLICY_VERSION=
OPTIONAL_NOTIFICATION_IN_APP_POLICY_VERSION=
RACE_NOTIFICATION_EMAIL_POLICY_VERSION=
RACE_NOTIFICATION_IN_APP_POLICY_VERSION=
NEWSLETTER_POLICY_VERSION=
# Configure an agreed privacy status expiry in seconds; blank refuses new requests.
PRIVACY_PROGRESS_LIFETIME_SECONDS=
PROOF_STORAGE_DIRECTORY=/app/var/private/proofs
PROOF_ALLOWED_MIME_TYPES=[]
PROOF_MAXIMUM_BYTES=0

# Import policies require approval; zero limits keep imports unavailable.
IMPORT_HEADERS_JSON={}
IMPORT_MAXIMUM_BYTES=0
IMPORT_MAXIMUM_ROWS=0
IMPORT_MUTABLE_FIELDS_JSON=[]

# Use a separate strong production newsletter key; retain old keys explicitly during rotation.
NEWSLETTER_SIGNING_SECRET=local-development-newsletter-only
NEWSLETTER_PREVIOUS_SIGNING_SECRETS_JSON=[]
