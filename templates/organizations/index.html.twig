{% extends 'base.html.twig' %}{% block title %}Mes organisations · RelaisDossard{% endblock %}{% block body %}<h1 class="text-4xl font-extrabold">Mon organisation</h1>{% if organization %}<a href="{{ path('organization_dashboard', {id: organization.id}) }}" class="my-8 block rounded-2xl ui-surface bg-white p-6 text-xl font-semibold underline">{{ organization.name }}</a>{% else %}<p role="status" class="my-8 rounded-2xl ui-surface bg-white p-6">Vous ne faites partie d’aucune organisation.</p><a class="underline" href="{{ path('organization_request') }}">Demander un accès organisateur</a>{% endif %}{% endblock %}
