{% extends 'base.html.twig' %}
{% block title %}Gestion du compte · RelaisDossard{% endblock %}
{% block body %}
<section class="mx-auto max-w-lg">
<h1 class="text-3xl font-bold">Gestion du compte</h1>
{% if message %}<p role="status" class="my-4">{{ message }}</p>{% endif %}
<form method="post" class="mt-6 grid gap-4">
<input type="hidden" name="_csrf_token" value="{{ csrf_token('account_lifecycle:' ~ accountId) }}">
<label>Nouvel état<select name="state" class="block w-full rounded border p-3"><option value="suspended">Suspendre le compte</option><option value="active">Réactiver le compte</option></select></label>
<label>Motif<textarea name="reason" class="block w-full rounded border p-3" required></textarea></label>
<p>Cette action est consignée. Elle ne modifie pas les paiements, les ventes ni les suspensions financières.</p>
<button class="rounded bg-forest px-5 py-3 font-bold text-white">Appliquer</button>
</form>
</section>
{% endblock %}
