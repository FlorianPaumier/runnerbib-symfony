{% extends 'base.html.twig' %}
{% block title %}Mes dossards et annonces · RelaisDossard{% endblock %}
{% block body %}
<h1 class="text-3xl font-bold">Mes dossards et annonces</h1>
{% if error %}<p role="alert" class="my-4 rounded-lg border border-red-700 ui-surface bg-white p-4">{{ error }}</p>{% endif %}
<p class="my-4">La publication exige un justificatif validé et un compte vendeur prêt. Une vente sur la plateforme ne remplace pas la procédure de transfert de la course.</p>
<a class="underline" href="{{ path('seller_onboarding') }}">Configurer mon compte vendeur</a>
{% set states = {'draft': 'Brouillon', 'published': 'En vente', 'withdrawn': 'Retiré', 'sold': 'Vendu'} %}
{% set activeEntitlements = items|filter(item => item.listingState in ['draft', 'published'])|map(item => item.entitlementId) %}
{% set draftForms = [] %}
<div class="mt-6 grid gap-6">
{% for item in items %}
<article class="rounded-xl border border-forest/15 ui-surface bg-white p-6">
<h2 class="text-xl font-semibold"><a class="underline" href="{{ path('race_detail', {id: item.raceId}) }}">{{ item.raceName }}</a> · Dossard {{ item.bibNumber }}</h2>
<p class="mt-2">{{ item.listingState ? states[item.listingState]|default('Indisponible') : 'Non proposé à la vente' }}</p>
{% if not item.ownsEntitlement %}<p>Ce dossard ne vous appartient plus. Cette annonce est conservée dans votre historique.</p>{% endif %}
{% if item.priceCents is not null %}<p class="mt-3">Prix du dossard : {{ item.priceCents|euros }}</p>{% endif %}
{% if item.ownsEntitlement and item.listingState in ['draft', 'published'] %}
{% set fees = item.fees %}
{% if fees %}
<p data-buyer-total>Total acheteur estimé : {{ fees.buyerTotalCents|euros }}</p>
<p data-seller-margin>Frais de plateforme vendeur : {{ fees.sellerMarginCents|euros }}</p>
<p data-seller-net>Net vendeur estimé : {{ fees.sellerNetCents|euros }}</p>
{% else %}<p>Les frais ne peuvent pas être calculés pour ce prix.</p>{% endif %}
{% endif %}
{% if item.proofId %}<p class="mt-3">{{ item.proofDecision == 'rejected' ? 'Justificatif refusé.' : 'Justificatif joint. Les conditions de publication sont vérifiées au moment de publier.' }}</p>{% endif %}
{% if item.ownsEntitlement and item.listingState in ['draft', 'published'] %}
<p class="mt-3 text-sm">Vous pouvez retirer l’annonce avant la fin de l’achat. Si un paiement est en cours, le retrait demande l’annulation de tout l’achat, y compris les autres dossards. Le paiement reste protégé jusqu’à la confirmation de son issue.</p>
<p class="mt-4 text-sm">Le net vendeur devient éligible à un transfert 72 heures après la validation du paiement, sous réserve des restrictions et des litiges. L’arrivée sur votre compte bancaire n’est pas garantie à une date précise.</p>
{% if item.checkoutProtected %}<p role="status" class="mt-3">Un paiement est en cours : le prix ne peut pas être modifié et le retrait ne débloque pas le paiement.</p>{% endif %}
{% if item.listingState == 'draft' %}
{% if item.approvedProofs %}
<form method="post" action="{{ path('seller_listing', {listingId: item.listingId}) }}" class="mt-4 grid gap-3">
<input type="hidden" name="_token" value="{{ csrf_token('seller_listing_justificatif_' ~ item.listingId) }}">
<input type="hidden" name="action" value="justificatif">
<input type="hidden" name="version" value="{{ item.listingVersion }}">
<label for="proof-{{ item.listingId }}">Justificatif validé pour ce dossard</label>
<select id="proof-{{ item.listingId }}" name="proof_id" required class="rounded-lg border border-forest/30 p-3">
{% for proof in item.approvedProofs %}<option value="{{ proof.id }}" {{ proof.id == item.proofId ? 'selected' : '' }}>Justificatif du {{ proof.submittedAt|date('d/m/Y à H:i', 'Europe/Paris') }}</option>{% endfor %}
</select>
<button class="rounded-lg border border-forest px-4 py-3 font-semibold">Joindre le justificatif</button>
</form>
{% else %}<p class="mt-3" role="status">Un justificatif validé est nécessaire avant publication. La validation concerne votre droit sur le dossard, pas la procédure de transfert de la course.</p>{% endif %}
<form method="post" action="{{ path('seller_listing', {listingId: item.listingId}) }}" class="mt-3">
<input type="hidden" name="_token" value="{{ csrf_token('seller_listing_publier_' ~ item.listingId) }}">
<input type="hidden" name="action" value="publier">
<input type="hidden" name="version" value="{{ item.listingVersion }}">
<button {{ item.proofId is null or item.proofDecision != 'approved' or item.proofVersion != item.reviewedVersion or not item.fees or item.checkoutProtected ? 'disabled' : '' }} class="rounded-lg bg-forest px-4 py-3 font-semibold text-white disabled:opacity-50">Publier l’annonce</button>
</form>
{% elseif not item.checkoutProtected %}
<form method="post" action="{{ path('seller_listing', {listingId: item.listingId}) }}" class="mt-4 grid gap-3">
<input type="hidden" name="_token" value="{{ csrf_token('seller_listing_prix_' ~ item.listingId) }}">
<input type="hidden" name="action" value="prix">
<input type="hidden" name="version" value="{{ item.listingVersion }}">
<label for="price-{{ item.listingId }}">Nouveau prix du dossard en euros</label>
<input id="price-{{ item.listingId }}" name="price" type="text" inputmode="decimal" required pattern="[0-9]+([,.][0-9]{1,2})?" value="{{ submitted.listingId|default(null) == item.listingId ? submitted.price|default('') : item.priceCents|euros|replace({' €': '', ' ': ''}) }}" class="rounded-lg border border-forest/30 p-3">
<p class="text-sm">Deux décimales maximum. Le nouveau prix démarre une nouvelle période de disponibilité.</p>
<button class="rounded-lg border border-forest px-4 py-3 font-semibold">Enregistrer le nouveau prix</button>
</form>
{% endif %}
<form method="post" action="{{ path('seller_listing', {listingId: item.listingId}) }}" class="mt-4">
<input type="hidden" name="_token" value="{{ csrf_token('seller_listing_retirer_' ~ item.listingId) }}">
<input type="hidden" name="action" value="retirer">
<input type="hidden" name="version" value="{{ item.listingVersion }}">
<button class="rounded-lg border border-red-700 px-4 py-3 font-semibold text-red-900">Retirer l’annonce</button>
</form>
{% endif %}
{% if item.ownsEntitlement and item.entitlementId not in activeEntitlements and item.entitlementId not in draftForms %}
{% set draftForms = draftForms|merge([item.entitlementId]) %}
<form method="post" action="{{ path('seller_draft', {entitlementId: item.entitlementId}) }}" class="mt-4 grid gap-3">
<input type="hidden" name="_token" value="{{ csrf_token('seller_draft_' ~ item.entitlementId) }}">
<input type="hidden" name="listing_id" value="{{ draftIds[item.entitlementId] }}">
<label for="price-{{ item.entitlementId }}">Prix du dossard en euros</label>
<input id="price-{{ item.entitlementId }}" name="price" type="text" inputmode="decimal" required pattern="[0-9]+([,.][0-9]{1,2})?" placeholder="100,00" value="{{ submitted.entitlementId|default(null) == item.entitlementId ? submitted.price|default('') : '' }}" class="rounded-lg border border-forest/30 p-3">
<p class="text-sm">Deux décimales maximum. Les frais et le net vendeur seront affichés avant publication.</p>
<button class="rounded-lg bg-forest px-4 py-3 font-semibold text-white">Enregistrer le brouillon</button>
</form>
{% endif %}
</article>
{% else %}<p role="status">Vous n’avez aucun dossard ou annonce dans cet espace.</p>{% endfor %}
</div>
{% endblock %}
