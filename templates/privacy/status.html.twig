{% extends 'base.html.twig' %}
{% block title %}Suivi de ma demande · RelaisDossard{% endblock %}
{% block body %}
<section class="mx-auto max-w-2xl">
<h1 class="text-3xl font-bold">Suivi de ma demande</h1>
{% if error %}<p role="alert" class="my-4 rounded-lg border border-red-700 ui-surface bg-white p-4">{{ error }}</p>{% endif %}
{% if record %}
{% set kinds = {'access_export': 'Accès à mes données', 'correction': 'Rectification de mes données', 'deletion': 'Suppression de mon compte'} %}
<h2 class="mt-6 text-xl font-semibold">{{ kinds[record.kind]|default('Demande de confidentialité') }}</h2>
<p role="status" class="my-4">Demande reçue, en attente de traitement.</p>
{% if record.kind == 'deletion' %}<p>Votre compte est désactivé et vos annonces invendues sont retirées. L’effacement des données reste en attente de traitement.</p>{% endif %}
{% for blocker in record.blockers %}
{% if blocker == 'financial_resolution' %}<p class="mt-3">Des paiements ou litiges doivent être examinés avant la fin du traitement. Leur protection reste active.</p>
{% elseif blocker == 'retention_policy' %}<p class="mt-3">Le calendrier d’effacement des données reste à préciser.</p>
{% else %}<p class="mt-3">Une vérification reste nécessaire avant la fin du traitement.</p>{% endif %}
{% endfor %}
<p class="my-4">Conservez ce code. Il donne accès au suivi de votre demande jusqu’au {{ record.authorityExpiresAt|date('d/m/Y à H:i:s', 'Europe/Paris') }} (heure de Paris).</p>
{% endif %}
<form method="post" action="{{ path('privacy_status') }}" data-turbo="false" class="mt-6 grid gap-3">
<label for="status-token">Code de suivi</label>
<textarea id="status-token" name="status_token" rows="4" required autocomplete="off" spellcheck="false" {{ record ? 'readonly' : '' }} class="w-full rounded-lg border border-forest/30 ui-surface bg-white p-3 font-mono text-sm">{{ token }}</textarea>
<button class="rounded-lg bg-forest px-4 py-3 font-semibold text-white">{{ record ? 'Actualiser le suivi' : 'Consulter ma demande' }}</button>
</form>
</section>
{% endblock %}
