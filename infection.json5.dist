{
    "source": {"directories": ["src/Domain", "src/Application"]},
    "timeout": 300,
    "threads": 4,
    "testFramework": "phpunit",
    "mutators": {"@default": true},
    "logs": {
        "text": "var/infection/infection.log",
        "summary": "var/infection/summary.log",
        "html": "var/infection/report.html"
    },
    "minMsi": 90,
    "minCoveredMsi": 95
}
